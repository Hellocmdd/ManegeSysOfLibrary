# 统一环境变量模板（后端 Java/JDBC 与前端 Flask 共用）
# 复制为仓库根目录 .env 后填写真实值；.env 已被 .gitignore 忽略，禁止提交。
# 系统环境变量优先级最高；src/frontend/.env 仅作为可选前端覆盖，不提供单独模板。

# ===== 数据库（默认：远程 MySQL 9.7.2，经 Tailscale 访问）=====
# 远程库在组长的 Tailscale 内网里，连之前先登录 Tailscale，
# 并让 Clash 等代理放过 100.64.0.0/10，否则会报 2013 Lost connection。
# 操作步骤见 docs/08_前端交付物/README.md「连接远程数据库（Tailscale）」。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=storageoflibrarysys
DB_USER=library
DB_PASSWORD=

# 远程库走 Tailscale：
#   DB_HOST=100.123.95.127
#   DB_PORT=3306
#   DB_USER=Manager
#   DB_PASSWORD=<组长给的口令>
# 远程库要求 TLS（mysql --ssl-mode=REQUIRED），DB_SSL 保持 1；
# 本机 MySQL 没开 TLS 时改成 0，否则会静默降级成明文再被服务器拒绝。
DB_SSL=1
# 会话时区。远程服务器多用 UTC，而借期与逾期判定取 CURDATE()，必须对齐东八区。
DB_TIME_ZONE=+08:00

# ===== 本地 Docker MySQL 8.4（可选）=====
# 使用仓库根目录 docker-compose.yml 前，把上面 DB_* 改为以下本地值：
#   DB_HOST=127.0.0.1
#   DB_PORT=3307
#   DB_USER=library
#   DB_PASSWORD=<本地 library 用户口令>
# 并填写下面的 root 口令；两者都只写本地 .env，不要提交。
# 容器内已设 --default-time-zone=+08:00，DB_TIME_ZONE 保持一致即可。
MYSQL_ROOT_PASSWORD=

# ===== 前端 Flask =====
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
PAGE_SIZE=10
