# ========== 数据库大作业 .gitignore ==========

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
ENV/

# Java / Maven
target/
*.class

# 依赖与构建产物
pip-wheel-metadata/
build/
dist/
*.egg-info/
node_modules/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 数据库备份文件
*.bak
*.sql.bak

# 凭据（绝对不能提交）
.env
.env.*
*.env
!.env.example
config_secret.py

# 日志与临时文件
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.iml

# logs
logs/

# codebuddy
.codebuddy/